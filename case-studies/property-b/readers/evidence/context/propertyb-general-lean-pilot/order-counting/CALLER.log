Aris4Math.General.RS.beforeAfter_ratio {n : ℕ} (A B : Finset (Fin n)) (x : Fin n) (hAB : Disjoint A B) (hxA : x ∉ A)
  (hxB : x ∉ B) :
  ↑(Fintype.card { σ // BeforeAfter A B x σ }) / ↑(Fintype.card (Perm (Fin n))) =
    ↑A.card.factorial * ↑B.card.factorial / ↑(A.card + B.card + 1).factorial
