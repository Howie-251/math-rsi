def Aris4Math.General.RS.rsFailureProbability.{u} : {V : Type u} → [Finite V] → Finset (Finset V) → ℝ → ℝ :=
fun {V} [Finite V] E p => Aris4Math.General.RS.failureProb (Aris4Math.General.RS.relabel (Fintype.equivFin V) E) p
Aris4Math.General.RS.rs_recoloring_failure_le.{u} {V : Type u} [Finite V] (E : Finset (Finset V)) (k : ℕ) (hk : 2 ≤ k)
  (hu : Aris4Math.General.RS.Uniform E k) {p : ℝ} (hp : 0 < p) (hp1 : p ≤ 1) :
  Aris4Math.General.RS.rsFailureProbability E p ≤
    1 - Aris4Math.General.RS.ak k p ^ (↑E.card / 2 ^ (k - 1)) +
      ↑(Aris4Math.General.RS.gamma E) / (2 ^ (k - 1)) ^ 2 * Aris4Math.General.RS.jk k p
Aris4Math.General.RS.propertyB_of_rs_bound.{u} {V : Type u} [Finite V] (E : Finset (Finset V)) (k : ℕ) (hk : 2 ≤ k)
  (hu : Aris4Math.General.RS.Uniform E k) {p : ℝ} (hp : 0 < p) (hp1 : p ≤ 1)
  (hbound :
    1 - Aris4Math.General.RS.ak k p ^ (↑E.card / 2 ^ (k - 1)) +
        ↑(Aris4Math.General.RS.gamma E) / (2 ^ (k - 1)) ^ 2 * Aris4Math.General.RS.jk k p <
      1) :
  Aris4Math.General.RS.PropertyB E
