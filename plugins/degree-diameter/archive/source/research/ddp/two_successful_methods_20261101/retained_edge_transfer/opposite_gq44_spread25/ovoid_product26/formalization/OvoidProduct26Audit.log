def DegreeDiameter.Portfolio.OvoidSpreadCloneCapacity.center.{u_1, u_2, u_3, u_4, u_5} : {P : Type u_1} →
  {L : Type u_2} → {V : Type u_3} → {J : Type u_4} → {I : Type u_5} → V ≃ P × L → (I → P) → (J → L) → I × J → V ⊕ J :=
fun {P} {L} {V} {J} {I} e ovoid spread ij => Sum.inl (e.symm (ovoid ij.1, spread ij.2))
def DegreeDiameter.Portfolio.OvoidProduct26.center : OvoidProduct26.CloneIndex → OvoidProduct26.Source.Vertex :=
OvoidSpreadCloneCapacity.center OppositeGQ44Spread.oldEquiv OvoidProduct26.ovoid OppositeGQ44Spread.spread
def DegreeDiameter.Portfolio.OvoidProduct26.graph : SimpleGraph OvoidProduct26.Vertex :=
FullNeighborhoodClones.graph OppositeGQ44Spread.graph OvoidProduct26.center
def DegreeDiameter.Portfolio.FullNeighborhoodClones.graph.{u_1, u_2} : {V : Type u_1} →
  {J : Type u_2} → SimpleGraph V → (J → V) → SimpleGraph (V ⊕ J) :=
fun {V} {J} G center =>
  {
    Adj := fun x x_1 =>
      match x, x_1 with
      | Sum.inl v, Sum.inl w => G.Adj v w
      | Sum.inl v, Sum.inr j => G.Adj v (center j)
      | Sum.inr j, Sum.inl v => G.Adj (center j) v
      | Sum.inr val, Sum.inr val_1 => False,
    symm := ⋯, loopless := ⋯ }
