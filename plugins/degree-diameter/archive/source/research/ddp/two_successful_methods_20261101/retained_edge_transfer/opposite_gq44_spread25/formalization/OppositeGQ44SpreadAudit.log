theorem DegreeDiameter.Portfolio.OppositeGQ44Spread.concrete_order_degree_and_exact_D3 : Fintype.card
      OppositeGQ44Spread.Vertex =
    7242 ∧
  (∀ (v : OppositeGQ44Spread.Vertex), OppositeGQ44Spread.graph.degree v ≤ 25) ∧
    DiameterAtMost OppositeGQ44Spread.graph 3 ∧ ¬DiameterAtMost OppositeGQ44Spread.graph 2 :=
have h :=
  OppositeIncidenceSpread.order_degree_and_exact_D3 OppositeGQ44Spread.oldEquiv OppositeGQ44Spread.linePoint
    OppositeGQ44Spread.pointLine OppositeGQ44Spread.spread OppositeGQ44Spread.spreadOwner
    (of_decide_eq_true (id (Eq.refl true))) OppositeGQ44Spread.pointLine_covers OppositeGQ44Spread.spread_unique
    OppositeGQ44Spread.projection (of_decide_eq_true (id (Eq.refl true)));
Eq.mp
  (congrArg
    (fun x =>
      Fintype.card (OppositeGQ44Spread.Old ⊕ OppositeGQ44Spread.New) = x ∧
        (∀ (u : OppositeGQ44Spread.Old ⊕ OppositeGQ44Spread.New),
            (OppositeIncidenceSpread.graph OppositeGQ44Spread.oldEquiv OppositeGQ44Spread.linePoint
                    OppositeGQ44Spread.spread).degree
                u ≤
              5 * 5) ∧
          DiameterAtMost
              (OppositeIncidenceSpread.graph OppositeGQ44Spread.oldEquiv OppositeGQ44Spread.linePoint
                OppositeGQ44Spread.spread)
              3 ∧
            ¬DiameterAtMost
                (OppositeIncidenceSpread.graph OppositeGQ44Spread.oldEquiv OppositeGQ44Spread.linePoint
                  OppositeGQ44Spread.spread)
                2)
    (congr (congrArg HAdd.hAdd (congr (congrArg HMul.hMul (Fintype.card_fin 85)) (Fintype.card_fin 85)))
      (Fintype.card_fin 17)))
  h
