DegreeDiameter.Portfolio.OppositeGQ44Spread.concrete_order_degree_and_exact_D3 :
  Fintype.card OppositeGQ44Spread.Vertex = 7242 ∧
    (∀ (v : OppositeGQ44Spread.Vertex), OppositeGQ44Spread.graph.degree v ≤ 25) ∧
