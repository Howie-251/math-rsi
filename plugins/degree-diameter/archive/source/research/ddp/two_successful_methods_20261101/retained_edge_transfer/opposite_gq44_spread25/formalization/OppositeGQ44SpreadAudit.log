def DegreeDiameter.Portfolio.OppositeGQSpread.graph.{u_1, u_2, u_3, u_4} : {P : Type u_1} →
  {L : Type u_2} → {V : Type u_3} → {J : Type u_4} → V ≃ P × L → (P → L → Prop) → (J → L) → SimpleGraph (V ⊕ J) :=
fun {P} {L} {V} {J} e Inc spread =>
  {
    Adj := fun x x_1 =>
      match x, x_1 with
      | Sum.inl u, Sum.inl v => u ≠ v ∧ Inc (e u).1 (e v).2 ∧ Inc (e v).1 (e u).2
      | Sum.inl u, Sum.inr j => Inc (e u).1 (e u).2 ∧ Inc (e u).1 (spread j)
      | Sum.inr j, Sum.inl u => Inc (e u).1 (e u).2 ∧ Inc (e u).1 (spread j)
      | Sum.inr val, Sum.inr val_1 => False,
    symm := ⋯, loopless := ⋯ }
def DegreeDiameter.Portfolio.OppositeIncidenceSpread.Inc.{u_1, u_2} : {P : Type u_1} →
  {L : Type u_2} → {a : ℕ} → (L → Fin a → P) → P → L → Prop :=
fun {P} {L} {a} linePoint p l => ∃ i, linePoint l i = p
def DegreeDiameter.Portfolio.OppositeGQ44Spread.graph : SimpleGraph OppositeGQ44Spread.Vertex :=
OppositeIncidenceSpread.graph OppositeGQ44Spread.oldEquiv OppositeGQ44Spread.linePoint OppositeGQ44Spread.spread
