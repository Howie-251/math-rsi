def DegreeDiameter.Portfolio.OppositeIncidenceSpread.Inc.{u_1, u_2} : {P : Type u_1} →
  {L : Type u_2} → {a : ℕ} → (L → Fin a → P) → P → L → Prop :=
fun {P} {L} {a} linePoint p l => ∃ i, linePoint l i = p
def DegreeDiameter.Portfolio.OppositeIncidenceSpread.graph.{u_1, u_2, u_3, u_4} : {P : Type u_1} →
  {L : Type u_2} →
    {V : Type u_3} → {J : Type u_4} → {a : ℕ} → V ≃ P × L → (L → Fin a → P) → (J → L) → SimpleGraph (V ⊕ J) :=
fun {P} {L} {V} {J} {a} e linePoint spread => OppositeGQSpread.graph e (OppositeIncidenceSpread.Inc linePoint) spread
def DegreeDiameter.Portfolio.OppositeIncidenceSpread.forward.{u_1, u_2, u_3, u_4} : {P : Type u_1} →
  {L : Type u_2} →
    {V : Type u_3} →
      {J : Type u_4} →
        {a b : ℕ} →
          [DecidableEq V] →
            V ≃ P × L → (L → Fin a → P) → (P → Fin b → L) → (J → L) → (P → J) → V ⊕ J → Fin (a * b) → V ⊕ J :=
fun {P} {L} {V} {J} {a b} [DecidableEq V] e linePoint pointLine spread spreadOwner u i =>
  OppositeGQSpread.slot e spread spreadOwner linePoint pointLine u (finProdFinEquiv.symm i)
@OppositeIncidenceSpread.degree_le : ∀ {P : Type u_1} {L : Type u_2} {V : Type u_3} {J : Type u_4} {a b : ℕ}
  [inst : Fintype V] [inst_1 : Fintype J] [inst_2 : DecidableEq V] [inst_3 : DecidableEq P] (e : V ≃ P × L)
  (linePoint : L → Fin a → P) (pointLine : P → Fin b → L) (spread : J → L) (spreadOwner : P → J),
  (∀ (p : P) (l : L), OppositeIncidenceSpread.Inc linePoint p l → ∃ i, pointLine p i = l) →
    (∀ (p : P) (j : J), OppositeIncidenceSpread.Inc linePoint p (spread j) → j = spreadOwner p) →
