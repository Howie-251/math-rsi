def DegreeDiameter.Portfolio.DiameterAtMost.{u_1} : {V : Type u_1} → SimpleGraph V → Nat → Prop :=
fun {V} G D => ∀ (u v : V), ∃ p, @LE.le Nat instLENat (@SimpleGraph.Walk.length V G u v p) D
def DegreeDiameter.Portfolio.OvoidSpreadCloneCapacity.center.{u_1, u_2, u_3, u_4, u_5} : {P : Type u_1} →
  {L : Type u_2} → {V : Type u_3} → {J : Type u_4} → {I : Type u_5} → V ≃ P × L → (I → P) → (J → L) → I × J → V ⊕ J :=
fun {P} {L} {V} {J} {I} e ovoid spread ij => Sum.inl (e.symm (ovoid ij.1, spread ij.2))
def DegreeDiameter.Portfolio.GQ77Cubic22Clone65.center : GQ77Cubic22Clone65.CloneIndex →
  GQ77Cubic22Clone65.Source.Vertex :=
fun k =>
  OvoidSpreadCloneCapacity.center OppositeGQ77Spread.oldEquiv GQ77Cubic22Clone65.ovoid OppositeGQ77Spread.spread
    (GQ77Cubic22Clone65.clonePair k)
def DegreeDiameter.Portfolio.GQ77Cubic22Clone65.graph : SimpleGraph GQ77Cubic22Clone65.Vertex :=
FullNeighborhoodClones.graph OppositeGQ77Spread.graph GQ77Cubic22Clone65.center
def DegreeDiameter.Portfolio.FullNeighborhoodClones.graph.{u_1, u_2} : {V : Type u_1} →
  {J : Type u_2} → SimpleGraph V → (J → V) → SimpleGraph (V ⊕ J) :=
fun {V} {J} G center =>
  {
    Adj := fun x x_1 =>
      match x, x_1 with
      | Sum.inl v, Sum.inl w => G.Adj v w
      | Sum.inl v, Sum.inr j => G.Adj v (center j)
      | Sum.inr j, Sum.inl v => G.Adj (center j) v
      | Sum.inr val, Sum.inr val_1 => False,
    symm := ⋯, loopless := ⋯ }
def DegreeDiameter.Portfolio.GQ77Cubic22Clone65.label : GQ77Cubic22Clone65.Vertex ≃ Fin 161150 :=
(OppositeGQ77Spread.label.sumCongr (Equiv.refl GQ77Cubic22Clone65.CloneIndex)).trans finSumFinEquiv
DegreeDiameter.Portfolio.GQ77Cubic22Clone65.center_source_label (k : GQ77Cubic22Clone65.CloneIndex) :
  ↑(OppositeGQ77Spread.label (GQ77Cubic22Clone65.center k)) =
    ↑(OppositeGQ77Spread.spread (GQ77Cubic22Clone65.clonePair k).2) +
      400 * ↑(GQ77Cubic22Clone65.ovoid (GQ77Cubic22Clone65.clonePair k).1)
DegreeDiameter.Portfolio.GQ77Cubic22Clone65.clone_label (i : Fin 22) (j : Fin 50) :
  ↑(GQ77Cubic22Clone65.cloneLabel (i, j)) = ↑j + 50 * ↑i
DegreeDiameter.Portfolio.GQ77Cubic22Clone65.label_old (v : GQ77Cubic22Clone65.Source.Vertex) :
  ↑(GQ77Cubic22Clone65.label (Sum.inl v)) = ↑(OppositeGQ77Spread.label v)
DegreeDiameter.Portfolio.GQ77Cubic22Clone65.label_new (k : GQ77Cubic22Clone65.CloneIndex) :
  ↑(GQ77Cubic22Clone65.label (Sum.inr k)) = 160050 + ↑k
DegreeDiameter.Portfolio.GQ77Cubic22Clone65.load_le_one (w : GQ77Cubic22Clone65.Source.Vertex) :
  FullNeighborhoodClones.load OppositeGQ77Spread.graph GQ77Cubic22Clone65.center w ≤ 1
DegreeDiameter.Portfolio.GQ77Cubic22Clone65.ovoid_unique (l : OppositeGQ77Spread.Line) (i i' : Fin 22) :
  OppositeGQ77Spread.Inc (GQ77Cubic22Clone65.ovoid i) l →
    OppositeGQ77Spread.Inc (GQ77Cubic22Clone65.ovoid i') l → i = i'
DegreeDiameter.Portfolio.GQ77Cubic22Clone65.source_no_isolated (v : GQ77Cubic22Clone65.Source.Vertex) :
  ∃ w, OppositeGQ77Spread.graph.Adj v w
DegreeDiameter.Portfolio.GQ77Cubic22Clone65.old_walk_bound_iff (u v : GQ77Cubic22Clone65.Source.Vertex) (n : ℕ) :
  (∃ p, p.length ≤ n) ↔ ∃ p, p.length ≤ n
DegreeDiameter.Portfolio.GQ77Cubic22Clone65.concrete_order_degree_and_exact_D3 :
  Fintype.card GQ77Cubic22Clone65.Vertex = 161150 ∧
    (∀ (v : GQ77Cubic22Clone65.Vertex), GQ77Cubic22Clone65.graph.degree v ≤ 65) ∧
      DiameterAtMost GQ77Cubic22Clone65.graph 3 ∧ ¬DiameterAtMost GQ77Cubic22Clone65.graph 2
theorem DegreeDiameter.Portfolio.GQ77Cubic22Clone65.concrete_order_degree_and_exact_D3 : Fintype.card
      GQ77Cubic22Clone65.Vertex =
    161150 ∧
  (∀ (v : GQ77Cubic22Clone65.Vertex), GQ77Cubic22Clone65.graph.degree v ≤ 65) ∧
    DiameterAtMost GQ77Cubic22Clone65.graph 3 ∧ ¬DiameterAtMost GQ77Cubic22Clone65.graph 2 :=
⟨GQ77Cubic22Clone65.card_vertex,
  ⟨GQ77Cubic22Clone65.degree_le_sixty_five,
    ⟨GQ77Cubic22Clone65.diameterAtMost_three, GQ77Cubic22Clone65.not_diameterAtMost_two⟩⟩⟩
def DegreeDiameter.Portfolio.GQ77Cubic22Clone65.FinalClaim : Prop :=
Fintype.card GQ77Cubic22Clone65.Vertex = 161150 ∧
  (∀ (v : GQ77Cubic22Clone65.Vertex), GQ77Cubic22Clone65.graph.degree v ≤ 65) ∧
    DiameterAtMost GQ77Cubic22Clone65.graph 3 ∧ ¬DiameterAtMost GQ77Cubic22Clone65.graph 2
