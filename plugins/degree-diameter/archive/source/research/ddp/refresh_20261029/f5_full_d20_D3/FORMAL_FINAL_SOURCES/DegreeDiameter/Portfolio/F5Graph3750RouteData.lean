def wordP0 (w : Fin 64) : Fin 4 := ⟨w.val % 4, Nat.mod_lt _ (by decide)⟩
def wordP1 (w : Fin 64) : Fin 4 := ⟨(w.val / 4) % 4, Nat.mod_lt _ (by decide)⟩
def wordP2 (w : Fin 64) : Fin 4 := ⟨(w.val / 16) % 4, Nat.mod_lt _ (by decide)⟩
def NBWord (w : Fin 64) : Prop :=
  wordP1 w ≠ inversePort (wordP0 w) ∧ wordP2 w ≠ inversePort (wordP1 w)
instance (w : Fin 64) : Decidable (NBWord w) := inferInstanceAs (Decidable (_ ∧ _))

def adjBefore (p : Fin 4) (d : Fin 125) : Prop := (adjacentDecoder p d).val < 500
