def adjP0 (p : Fin 4) (d : Fin 125) : Fin 4 := if adjBefore p d then adjQ p d else p
def adjP1 (p : Fin 4) (d : Fin 125) : Fin 4 :=
  if adjBefore p d then inversePort (adjQ p d) else adjQ p d
def adjP2 (p : Fin 4) (d : Fin 125) : Fin 4 :=
  if adjBefore p d then p else inversePort (adjQ p d)
