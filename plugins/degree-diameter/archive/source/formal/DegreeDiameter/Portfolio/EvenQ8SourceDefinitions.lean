def linePoint (l : Line) (i : Fin 8) : Point :=
  ⟨((lineRows.get l.val / 1024^i.val) % 1024) % 512, Nat.mod_lt _ (by decide)⟩
def pointLine (p : Point) (i : Fin 10) : Line :=
  ⟨((pointRows.get p.val / 1024^i.val) % 1024) % 640, Nat.mod_lt _ (by decide)⟩
def spread (j : Helper) : Line := ⟨spreadRows.get j.val % 640, Nat.mod_lt _ (by decide)⟩
def spreadOwner (p : Point) : Helper := ⟨ownerRows.get p.val % 64, Nat.mod_lt _ (by decide)⟩
abbrev Inc := OppositeIncidenceSpread.Inc linePoint
def graph : SimpleGraph Vertex := OppositeIncidenceSpread.graph oldEquiv linePoint spread
instance : DecidableRel graph.Adj := inferInstanceAs
  (DecidableRel (OppositeIncidenceSpread.graph oldEquiv linePoint spread).Adj)
theorem old_label_coordinates (p : Point) (l : Line) :
    (oldEquiv.symm (p,l)).val = l.val+640*p.val := rfl
theorem label_old (v : Old) : (label (.inl v)).val = v.val := rfl
theorem label_new (h : Helper) : (label (.inr h)).val = 327680+h.val := rfl
theorem card_vertex : Fintype.card Vertex = 327744 := by
  simp only [Fintype.card_sum,Fintype.card_fin]
