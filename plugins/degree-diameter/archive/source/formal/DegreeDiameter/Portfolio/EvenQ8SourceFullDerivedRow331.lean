def witnessWord (l : Line) : Nat :=
  (witnessBlocks.get (l.val/32) / 4194304^(l.val%32)) % 4194304
def qSlot (l : Line) : Fin 8 := ⟨witnessWord l % 16 % 8, Nat.mod_lt _ (by decide)⟩
def connector (l : Line) : Line := ⟨(witnessWord l / 16) % 1024 % 640, Nat.mod_lt _ (by decide)⟩
def pSlot (l : Line) : Fin 8 := ⟨(witnessWord l / 16384) % 16 % 8, Nat.mod_lt _ (by decide)⟩
def qConnectorSlot (l : Line) : Fin 8 := ⟨(witnessWord l / 262144) % 16 % 8, Nat.mod_lt _ (by decide)⟩
theorem certificate : ∀ l : Line,
    linePoint (connector l) (pSlot l) = (331 : Point) ∧
    linePoint (connector l) (qConnectorSlot l) = linePoint l (qSlot l) := by decide
theorem projection : ∀ l : Line,
    ∃ q m, Inc q l ∧ Inc (331 : Point) m ∧ Inc q m := by
  intro l
  refine ⟨linePoint l (qSlot l),connector l,⟨qSlot l,rfl⟩,?_,?_⟩
  · exact ⟨pSlot l,(certificate l).1⟩
  · exact ⟨qConnectorSlot l,(certificate l).2⟩
#print axioms projection
