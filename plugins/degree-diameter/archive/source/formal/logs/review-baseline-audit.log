'DegreeDiameter.brown57_degree' depends on axioms: [propext, Classical.choice, Quot.sound]
'DegreeDiameter.exists82_57' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem original_baseline : DegreeDiameter.Exists82 57 ∧ ∀ (n : ℕ), DegreeDiameter.Exists82 n → n ≤ 65 :=
⟨DegreeDiameter.exists82_57, fun x h => DegreeDiameter.exists82_le_65 h⟩
