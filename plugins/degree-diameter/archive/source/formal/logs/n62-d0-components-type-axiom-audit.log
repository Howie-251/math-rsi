def DegreeDiameter.ClosedDoubleFour.{u_1} : {V : Type u_1} → [Fintype V] → SimpleGraph V → V → V → V → V → Prop :=
fun {V} [Fintype V] G r w b a =>
  r ≠ w ∧
    r ≠ b ∧
      r ≠ a ∧
        w ≠ b ∧
          w ≠ a ∧
            b ≠ a ∧
              DegreeDiameter.twoOneRow G r w a ∧
                DegreeDiameter.twoOneRow G w r b ∧ DegreeDiameter.twoOneRow G a b r ∧ DegreeDiameter.twoOneRow G b a w
@DegreeDiameter.n62_d0_parent_root_row : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  DegreeDiameter.degreeAtMostEight G →
    DegreeDiameter.diameterAtMostTwo G →
      Fintype.card V = 62 →
        ∀ {r i j k b d w a : V}, DegreeDiameter.D0ParentTemplate G r i j k b d w a → DegreeDiameter.twoOneRow G r w a
@DegreeDiameter.n62_d0_parent_repeat_profile : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  DegreeDiameter.degreeAtMostEight G →
    DegreeDiameter.diameterAtMostTwo G →
      Fintype.card V = 62 →
        ∀ {r i j k b d w a : V},
          DegreeDiameter.D0ParentTemplate G r i j k b d w a →
            ∀ (x : V), G.Adj r x → DegreeDiameter.defectMatrix G i x = (if x = j then 1 else 0) + if x = k then 1 else 0
@DegreeDiameter.n62_d0_match_closed_component : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  DegreeDiameter.degreeAtMostEight G →
    DegreeDiameter.diameterAtMostTwo G →
      Fintype.card V = 62 →
        ∀ {r i j k p q w a : V},
          DegreeDiameter.D0ParentTemplate G r i j k p q w a →
            ¬G.Adj w a →
              ∃ b,
                DegreeDiameter.ClosedDoubleFour G r w b a ∧
                  ¬G.Adj r w ∧ ¬G.Adj r b ∧ ¬G.Adj r a ∧ ¬G.Adj w b ∧ ¬G.Adj w a ∧ ¬G.Adj b a
@DegreeDiameter.bout_common_neighbors_of_unit_repeat : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V)
  {w b : V},
  w ≠ b →
    ¬G.Adj w b → DegreeDiameter.defectMatrix G w b = 1 → ∃ t u, t ≠ u ∧ G.Adj w t ∧ G.Adj t b ∧ G.Adj w u ∧ G.Adj u b
@DegreeDiameter.n62_d0_bout_closed_component : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  DegreeDiameter.degreeAtMostEight G →
    DegreeDiameter.diameterAtMostTwo G →
      Fintype.card V = 62 →
        ∀ {r i j k p q w a b : V},
          DegreeDiameter.D0EdgeBoutTemplate G r i j k p q w a b →
            DegreeDiameter.ClosedDoubleFour G r w b a ∧
              G.Adj r b ∧ G.Adj w a ∧ ¬G.Adj r w ∧ ¬G.Adj r a ∧ ¬G.Adj w b ∧ ¬G.Adj b a
@DegreeDiameter.closedDoubleFour_no_external_repeat : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V)
  {r w b a v x : V},
  DegreeDiameter.ClosedDoubleFour G r w b a →
    v = r ∨ v = w ∨ v = b ∨ v = a → x ≠ r → x ≠ w → x ≠ b → x ≠ a → DegreeDiameter.defectMatrix G v x = 0
@DegreeDiameter.d0_bout_template_of_unit_repeat : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V)
  {r i j k p q w a b : V},
  DegreeDiameter.D0ParentTemplate G r i j k p q w a →
    G.Adj w a →
      G.Adj r b →
        b ≠ i →
          b ≠ j →
            b ≠ k →
              b ≠ p →
                b ≠ q → DegreeDiameter.defectMatrix G w b = 1 → DegreeDiameter.D0EdgeBoutTemplate G r i j k p q w a b
