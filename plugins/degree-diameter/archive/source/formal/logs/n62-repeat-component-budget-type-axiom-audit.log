@DegreeDiameter.n62_repeat_component_weight_sum : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  DegreeDiameter.degreeAtMostEight G →
    DegreeDiameter.diameterAtMostTwo G →
      Fintype.card V = 62 → ∑ C, (1 + 2 * DegreeDiameter.repeatQuotientMatrix G C C) = 17
@DegreeDiameter.n62_repeat_component_subset_budget : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  DegreeDiameter.degreeAtMostEight G →
    DegreeDiameter.diameterAtMostTwo G →
      Fintype.card V = 62 →
        ∀ (S : Finset (DegreeDiameter.repeatSupport G).ConnectedComponent),
          ↑S.card + 2 * ∑ C ∈ S, DegreeDiameter.repeatQuotientMatrix G C C ≤ 17
@DegreeDiameter.n62_no_six_components_three_internal_two : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  DegreeDiameter.degreeAtMostEight G →
    DegreeDiameter.diameterAtMostTwo G →
      Fintype.card V = 62 →
        6 ≤ Fintype.card (DegreeDiameter.repeatSupport G).ConnectedComponent →
          ∀ (S : Finset (DegreeDiameter.repeatSupport G).ConnectedComponent),
            S.card = 3 → (∀ C ∈ S, 2 ≤ DegreeDiameter.repeatQuotientMatrix G C C) → False
'DegreeDiameter.n62_repeat_component_weight_sum' depends on axioms: [propext, Classical.choice, Quot.sound]
'DegreeDiameter.n62_repeat_component_subset_budget' depends on axioms: [propext, Classical.choice, Quot.sound]
'DegreeDiameter.n62_no_six_components_three_internal_two' depends on axioms: [propext, Classical.choice, Quot.sound]
