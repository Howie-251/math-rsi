  (∀ (v : V), DegreeDiameter.matchingRow G v) → (DegreeDiameter.defectMatrix G ^ 2).trace = 10 * ↑(Fintype.card V)
@DegreeDiameter.matching_rows_mixed_trace : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  (∀ (v : V), DegreeDiameter.matchingRow G v) →
    (DegreeDiameter.adjacencyMatrix G * DegreeDiameter.defectMatrix G ^ 2).trace = 10 * ↑(Fintype.card V)
@DegreeDiameter.triangle_free_cube_trace : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  DegreeDiameter.triangleFree G → (DegreeDiameter.adjacencyMatrix G ^ 3).trace = 0
