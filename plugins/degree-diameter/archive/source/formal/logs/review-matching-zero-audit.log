  DegreeDiameter.degreeAtMostEight G →
    DegreeDiameter.diameterAtMostTwo G →
      Fintype.card V = 59 →
        (DegreeDiameter.adjacencyMatrix G ^ 3).trace = 0 →
          (DegreeDiameter.defectMatrix G ^ 2).trace = 590 →
            (DegreeDiameter.adjacencyMatrix G * DegreeDiameter.defectMatrix G ^ 2).trace = 590 → False
