theorem original_baseline : DegreeDiameter.Exists82 57 ∧ ∀ (n : ℕ), DegreeDiameter.Exists82 n → n ≤ 65 :=
⟨DegreeDiameter.exists82_57, fun x h => DegreeDiameter.exists82_le_65 h⟩
'original_baseline' depends on axioms: [propext, Classical.choice, Quot.sound]
def DegreeDiameter.adjacencyMatrix.{u_1} : {V : Type u_1} → SimpleGraph V → Matrix V V ℤ :=
fun {V} G => SimpleGraph.adjMatrix ℤ G
def DegreeDiameter.onesMatrix.{u_1} : {V : Type u_1} → Matrix V V ℤ :=
fun {V} x x => 1
def DegreeDiameter.defectMatrix.{u_1} : {V : Type u_1} → [Fintype V] → SimpleGraph V → Matrix V V ℤ :=
fun {V} [Fintype V] G =>
  DegreeDiameter.adjacencyMatrix G * DegreeDiameter.adjacencyMatrix G + DegreeDiameter.adjacencyMatrix G - 7 • 1 -
    DegreeDiameter.onesMatrix
def DegreeDiameter.commonNeighborCount.{u_1} : {V : Type u_1} → [Fintype V] → SimpleGraph V → V → V → ℕ :=
fun {V} [Fintype V] G u v => {w ∈ G.neighborFinset u | G.Adj w v}.card
@DegreeDiameter.adjacency_sq_common_count : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V) (u v : V),
  (DegreeDiameter.adjacencyMatrix G * DegreeDiameter.adjacencyMatrix G) u v =
    ↑(DegreeDiameter.commonNeighborCount G u v)
@DegreeDiameter.defect_diagonal : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  G.IsRegularOfDegree 8 → ∀ (v : V), DegreeDiameter.defectMatrix G v v = 0
@DegreeDiameter.defect_symmetric : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  (DegreeDiameter.defectMatrix G).IsSymm
@DegreeDiameter.defect_off_diagonal : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V) {u v : V},
  u ≠ v →
    DegreeDiameter.defectMatrix G u v =
      ↑(DegreeDiameter.commonNeighborCount G u v) + DegreeDiameter.adjacencyMatrix G u v - 1
@DegreeDiameter.defect_nonnegative : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  G.IsRegularOfDegree 8 → DegreeDiameter.diameterAtMostTwo G → ∀ (u v : V), 0 ≤ DegreeDiameter.defectMatrix G u v
@DegreeDiameter.defect_row_sum : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  G.IsRegularOfDegree 8 → ∀ (u : V), ∑ v, DegreeDiameter.defectMatrix G u v = 65 - ↑(Fintype.card V)
@DegreeDiameter.adjacency_defect_commute : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  G.IsRegularOfDegree 8 →
    DegreeDiameter.adjacencyMatrix G * DegreeDiameter.defectMatrix G =
      DegreeDiameter.defectMatrix G * DegreeDiameter.adjacencyMatrix G
@DegreeDiameter.original_graph_defect_properties : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  DegreeDiameter.degreeAtMostEight G →
    DegreeDiameter.diameterAtMostTwo G →
      57 < Fintype.card V →
        (∀ (v : V), DegreeDiameter.defectMatrix G v v = 0) ∧
          (DegreeDiameter.defectMatrix G).IsSymm ∧
            (∀ (u v : V), 0 ≤ DegreeDiameter.defectMatrix G u v) ∧
              (∀ (u : V), ∑ v, DegreeDiameter.defectMatrix G u v = 65 - ↑(Fintype.card V)) ∧
                DegreeDiameter.adjacencyMatrix G * DegreeDiameter.defectMatrix G =
                  DegreeDiameter.defectMatrix G * DegreeDiameter.adjacencyMatrix G
