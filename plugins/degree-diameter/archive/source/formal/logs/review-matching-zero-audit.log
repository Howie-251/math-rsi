@DegreeDiameter.five_dvd_trace_fifth_of_trace_zero : ∀ {V : Type u_1} [inst : Fintype V] (A : Matrix V V ℤ),
  A.trace = 0 → 5 ∣ (A ^ 5).trace
@DegreeDiameter.five_dvd_adjacency_fifth : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  5 ∣ (DegreeDiameter.adjacencyMatrix G ^ 5).trace
@DegreeDiameter.fifth_matrix_identity_59 : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  G.IsRegularOfDegree 8 →
    Fintype.card V = 59 →
      DegreeDiameter.adjacencyMatrix G ^ 5 =
        DegreeDiameter.adjacencyMatrix G * DegreeDiameter.defectMatrix G ^ 2 - 2 • DegreeDiameter.defectMatrix G ^ 2 +
                  17 • DegreeDiameter.adjacencyMatrix G ^ 3 -
                12 • DegreeDiameter.adjacencyMatrix G ^ 2 -
              77 • DegreeDiameter.adjacencyMatrix G +
            98 • 1 +
          426 • DegreeDiameter.onesMatrix
@DegreeDiameter.fifth_trace_identity_59 : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  G.IsRegularOfDegree 8 →
    Fintype.card V = 59 →
      (DegreeDiameter.adjacencyMatrix G ^ 5).trace =
        25252 + (DegreeDiameter.adjacencyMatrix G * DegreeDiameter.defectMatrix G ^ 2).trace -
            2 * (DegreeDiameter.defectMatrix G ^ 2).trace +
          17 * (DegreeDiameter.adjacencyMatrix G ^ 3).trace
