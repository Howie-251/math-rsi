def DegreeDiameter.triangleFree.{u_1} : {V : Type u_1} → SimpleGraph V → Prop :=
fun {V} G => ∀ (u v w : V), G.Adj u v → G.Adj v w → ¬G.Adj w u
def DegreeDiameter.matchingRow.{u_1} : {V : Type u_1} → [Fintype V] → SimpleGraph V → V → Prop :=
fun {V} [Fintype V] G v =>
  ∃ a b c d,
    a ≠ b ∧
      a ≠ c ∧
        a ≠ d ∧
          b ≠ c ∧
            b ≠ d ∧
              c ≠ d ∧
                (∀ (u : V),
                    DegreeDiameter.defectMatrix G v u =
                      (((if u = a then 2 else 0) + if u = b then 2 else 0) + if u = c then 1 else 0) +
                        if u = d then 1 else 0) ∧
                  G.Adj a b ∧ G.Adj c d ∧ ¬G.Adj a c ∧ ¬G.Adj a d ∧ ¬G.Adj b c ∧ ¬G.Adj b d
@DegreeDiameter.matching_row_square : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V) (v : V),
  DegreeDiameter.matchingRow G v → (DegreeDiameter.defectMatrix G ^ 2) v v = 10
