structure DegreeDiameter.D2MatchTemplate.{u_1} {V : Type u_1} (G : SimpleGraph V) (r i j k w a : V) : Prop
number of parameters: 8
fields:
  DegreeDiameter.D2MatchTemplate.root_i : G.Adj r i
  DegreeDiameter.D2MatchTemplate.root_j : G.Adj r j
  DegreeDiameter.D2MatchTemplate.root_k : G.Adj r k
  DegreeDiameter.D2MatchTemplate.i_ne_j : i ≠ j
  DegreeDiameter.D2MatchTemplate.i_ne_k : i ≠ k
  DegreeDiameter.D2MatchTemplate.j_ne_k : j ≠ k
  DegreeDiameter.D2MatchTemplate.w_ne_root : w ≠ r
  DegreeDiameter.D2MatchTemplate.a_ne_root : a ≠ r
  DegreeDiameter.D2MatchTemplate.w_ne_a : w ≠ a
  DegreeDiameter.D2MatchTemplate.root_w_nonadj : ¬G.Adj r w
  DegreeDiameter.D2MatchTemplate.root_a_nonadj : ¬G.Adj r a
  DegreeDiameter.D2MatchTemplate.w_a_nonadj : ¬G.Adj w a
  DegreeDiameter.D2MatchTemplate.root_independent : ∀ (x y : V), G.Adj r x → G.Adj r y → ¬G.Adj x y
  DegreeDiameter.D2MatchTemplate.w_parents : ∀ (x : V), G.Adj r x → (G.Adj x w ↔ x = i ∨ x = j ∨ x = k)
  DegreeDiameter.D2MatchTemplate.a_parents : ∀ (x : V), G.Adj r x → (G.Adj x a ↔ x = i ∨ x = j)
