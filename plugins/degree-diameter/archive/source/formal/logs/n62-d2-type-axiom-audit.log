constructor:
  DegreeDiameter.D2MatchTemplate.mk.{u_1} {V : Type u_1} {G : SimpleGraph V} {r i j k w a : V} (root_i : G.Adj r i)
    (root_j : G.Adj r j) (root_k : G.Adj r k) (i_ne_j : i ≠ j) (i_ne_k : i ≠ k) (j_ne_k : j ≠ k) (w_ne_root : w ≠ r)
