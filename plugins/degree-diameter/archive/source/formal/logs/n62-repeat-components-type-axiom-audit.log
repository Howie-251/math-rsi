def DegreeDiameter.repeatSupport.{u_1} : {V : Type u_1} → [Fintype V] → SimpleGraph V → SimpleGraph V :=
fun {V} [Fintype V] G => { Adj := fun x y => x ≠ y ∧ 0 < DegreeDiameter.defectMatrix G x y, symm := ⋯, loopless := ⋯ }
def DegreeDiameter.repeatComponentVertices.{u_1} : {V : Type u_1} →
  [inst : Fintype V] → (G : SimpleGraph V) → (DegreeDiameter.repeatSupport G).ConnectedComponent → Finset V :=
fun {V} [Fintype V] G C => {x | x ∈ C.supp}
def DegreeDiameter.repeatComponentIndicator.{u_1} : {V : Type u_1} →
  [inst : Fintype V] → (G : SimpleGraph V) → (DegreeDiameter.repeatSupport G).ConnectedComponent → V → ℤ :=
fun {V} [Fintype V] G C x => if x ∈ C.supp then 1 else 0
def DegreeDiameter.repeatComponentNeighborCount.{u_1} : {V : Type u_1} →
  [inst : Fintype V] → (G : SimpleGraph V) → (DegreeDiameter.repeatSupport G).ConnectedComponent → V → ℕ :=
fun {V} [Fintype V] G C x => {y ∈ G.neighborFinset x | y ∈ C.supp}.card
def DegreeDiameter.repeatComponentDegree.{u_1} : {V : Type u_1} →
  [inst : Fintype V] →
    (G : SimpleGraph V) →
      (DegreeDiameter.repeatSupport G).ConnectedComponent → (DegreeDiameter.repeatSupport G).ConnectedComponent → ℕ :=
fun {V} [Fintype V] G D C => DegreeDiameter.repeatComponentNeighborCount G C (Exists.choose ⋯)
def DegreeDiameter.repeatQuotientMatrix.{u_1} : {V : Type u_1} →
  [inst : Fintype V] →
    (G : SimpleGraph V) →
      Matrix (DegreeDiameter.repeatSupport G).ConnectedComponent (DegreeDiameter.repeatSupport G).ConnectedComponent
        ℤ :=
fun {V} [Fintype V] G D C => ↑(DegreeDiameter.repeatComponentDegree G D C)
