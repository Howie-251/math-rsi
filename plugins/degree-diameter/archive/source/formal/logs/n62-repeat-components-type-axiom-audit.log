@DegreeDiameter.integer_weighted_harmonic_edge_eq : ∀ {V : Type u_1} [inst : Fintype V] (B : Matrix V V ℤ) (k : ℤ)
  (f : V → ℤ),
  (∀ (x y : V), 0 ≤ B x y) →
