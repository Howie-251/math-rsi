def loss (i : Case) (k : ℕ) : ℚ :=
  if k=(positions i 0).val+1 then losses i 0 else
  if k=(positions i 1).val+1 then losses i 1 else
  if k=(positions i 2).val+1 then losses i 2 else
  if k=(positions i 3).val+1 then losses i 3 else 0

def R (j : Fin 4) (_ : Fin 1) : Finset (Fin 4) := Finset.univ.erase j
def pureQ (i : Case) (j : Fin 4) : ℕ := (4*μ i {j}+2-16)/3
def pureWeight (i : Case) (j : Fin 4) : ℚ :=
  2 * Numeric.pairWeight (p i) ⟨[(positions i j).val+1],0⟩
    ⟨[(positions i j).val+1],0⟩ ((positions i j).val+1)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem certificates : ∀ i : Case,
    Numeric.validProfile (p i) 34 ∧
    (∑ k : Fin 20, min (Numeric.boundA (p i) (k.val+1))
      (min (Numeric.boundB (p i) (k.val+1)) (Numeric.boundC (p i) (k.val+1)-loss i (k.val+1)))) < 1 ∧
    ∀ j : Fin 4, let k := (positions i j).val+1
      if usePure i j then
        0 ≤ pureWeight i j ∧
        (∀ z : Fin 1, pureQ i j ≤
          (4*RD.avoidedCount (p i) k (RD.avoidedPositions (positions i) (R j z))+2-
            (20-1-(R j z).card))/3) ∧
        loss i k ≤ (∑ _z : Fin 1, (pureQ i j : ℚ)*pureWeight i j) -
          RD.penaltySum (p i) k (fun z => RD.avoidedPositions (positions i) (R j z))
            (fun _z => pureWeight i j)
      else
        0 ≤ threshold (p i) k ∧
        loss i k ≤ (((4*degree (kindOf i) j-19+2)/3 : ℕ) : ℚ)*threshold (p i) k - penaltySum (p i) k (threshold (p i) k) := by
  intro i
  fin_cases i <;> simp only [loss,pureWeight,p_eq_computed] <;>
    unfold Numeric.validProfile <;> decide +kernel

theorem realizes34 (H : Simple5Hypergraph (Fin 20)) (vertices : Fin 4 ↪ Fin 20)
    (i : Case) (hμ : ∀ T, count H vertices T = μ i T)
    (valid : Numeric.validProfile (p i) 34) :
    RealizesProfile H vertices (positions i) (p i) 34 := by
  rw [p_eq] at valid ⊢
  refine ⟨rfl,valid,?_,table_pruneZero _ _ _ (raw_table H vertices (positions i) (μ i) hμ _)⟩
  simp [profile,pruneZero,rawProfile,canonicalType]

theorem propertyB_of_data (H : Simple5Hypergraph (Fin 20)) (cover : H.PairCovering)
    (edges34 : H.edges.card = 34) (vertices : Fin 4 ↪ Fin 20) (i : Case)
    (hd : ∀ j, H.degree (vertices j) = degree (kindOf i) j)
    (hc : ∀ j, H.codegree (vertices (first j)) (vertices (second j)) = co (kindOf i) j)
    (ht : ∀ a, count H vertices (highLabels a) = high i a) : PropertyB H := by
  obtain ⟨valid,strict,bounds⟩ := certificates i
  have hm : ∀ T, count H vertices T = μ i T := by
    intro T
    rw [actual_recovered,edges34]
    rw [show (fun j => H.degree (vertices j)) = degree (kindOf i) from funext hd,
      show (fun j => H.codegree (vertices (first j)) (vertices (second j))) = co (kindOf i) from funext hc,
      show (fun j => count H vertices (highLabels j)) = high i from funext ht]
    rfl
  have real := realizes34 H vertices i hm valid
  apply ThirtyThree.CustomDeletion.propertyB_of_custom_deletion H vertices (positions i) (p i) real rfl (loss i)
  · intro j _
    have hb := bounds j
    dsimp only at hb
    by_cases hp : usePure i j = true
    · rw [if_pos hp] at hb
      obtain ⟨nonneg,quota,bound⟩ := hb
      exact RD.realized_refined_deduction H vertices (positions i) (p i) real j
        (R j) (fun _ : Fin 1 => pureWeight i j) (fun _ => pureQ i j) _
        (fun _ => nonneg) (fun _ => by simp [R]) quota bound
    · rw [if_neg hp] at hb
      apply realized_threshold_deduction H cover vertices (positions i) (p i) real j _ ((4*degree (kindOf i) j-19+2)/3) _ _ rfl
      · rw [hd]
      · exact hb.1
      · exact hb.2
  · intro k hk
    have absent : ∀ j : Fin 4, k ≠ (positions i j).val+1 := by
      intro j he
      apply hk
      simp only [p,pruneZero]
      exact List.mem_ofFn.mpr ⟨j,he.symm⟩
    simp [loss,absent 0,absent 1,absent 2,absent 3]
  · exact strict

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem coverage : ∀ kind : Fin 3, ∀ h : Fin 5 → Fin 3,
    (∀ j, highPairSum (fun a => (h a).val) j ≤ co kind j) →
    ∃ i : Case, kindOf i=kind ∧ ∀ a, (h a).val=high i a := by
  intro kind
  fin_cases kind <;> decide +kernel

theorem propertyB_of_quad (H : Simple5Hypergraph (Fin 20)) (cover : H.PairCovering)
    (edges34 : H.edges.card = 34) (vertices : Fin 4 ↪ Fin 20) (kind : Fin 3)
    (hd : ∀ j, H.degree (vertices j) = degree kind j)
    (hc : ∀ j, H.codegree (vertices (first j)) (vertices (second j)) = co kind j) : PropertyB H := by
  have coSmall : ∀ kind : Fin 3, ∀ j, co kind j ≤ 2 := by decide
  have bounded := high_le_two H vertices (fun j => by rw [hc]; exact coSmall kind j)
  let h : Fin 5 → Fin 3 := fun a => ⟨count H vertices (highLabels a),by have := bounded a; omega⟩
  have inventory : ∀ j, highPairSum (fun a => (h a).val) j ≤ co kind j := by
    intro j
    change highPairSum (fun a => count H vertices (highLabels a)) j ≤ co kind j
    rw [← hc j]
    exact high_inventory H vertices j
  obtain ⟨i,kindEq,ht⟩ := coverage kind h inventory
  apply propertyB_of_data H cover edges34 vertices i
  · simpa only [kindEq] using hd
  · simpa only [kindEq] using hc
  · exact ht

end Aris4Math.ThirtyFour.TwentySevenQuad
