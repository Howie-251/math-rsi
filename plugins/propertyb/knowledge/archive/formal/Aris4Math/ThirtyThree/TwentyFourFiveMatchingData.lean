private theorem profile_ext (a b : Numeric.Profile)
    (hv : a.v = b.v) (hp : a.positions = b.positions) (ht : a.types = b.types)
    (hc : a.emptyPairCap = b.emptyPairCap) (hk : a.correctionCenters = b.correctionCenters) :
    a = b := by
  cases a
  cases b
  simp_all

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem p_eq_computed (k : Fin 18) : p k = computed k := by
  fin_cases k <;> apply profile_ext <;> decide +kernel

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem bounded_certificates : ∀ k : Fin 18, Numeric.validProfile (p k) 33 ∧
    Numeric.totalBound (p k) ≤ (8273:ℚ)/8398 ∧ (p k).emptyPairCap = none ∧
    (p k).correctionCenters = [] := by
  simp only [p_eq_computed]
  unfold Numeric.validProfile
  intro k
  fin_cases k <;> decide +kernel

theorem uniform_bound (k : Fin 18) : Numeric.totalBound (p k) ≤ (8273:ℚ)/8398 :=
  (bounded_certificates k).2.1

theorem certificates (k : Fin 18) : Numeric.validProfile (p k) 33 ∧
    Numeric.totalBound (p k) < 1 ∧ (p k).emptyPairCap = none ∧
    (p k).correctionCenters = [] := by
  obtain ⟨valid,bound,hcap,hcenters⟩ := bounded_certificates k
  exact ⟨valid,lt_of_le_of_lt bound (by norm_num),hcap,hcenters⟩
end Aris4Math.ThirtyThree.TwentyFourFiveMatchingData
