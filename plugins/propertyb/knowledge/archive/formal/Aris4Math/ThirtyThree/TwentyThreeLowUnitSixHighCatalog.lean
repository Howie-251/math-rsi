def cost (a : Fin 41) (p : Fin 15) : ℕ :=
  if first p ∈ largeType a ∧ second p ∈ largeType a then 1 else 0

theorem largeType_injective : Function.Injective largeType := by decide +kernel
theorem largeType_cards : ∀ a, 3 ≤ (largeType a).card ∧ (largeType a).card ≤ 5 := by decide +kernel
theorem largeType_complete : ∀ T : Finset (Fin 6), 3 ≤ T.card → T.card ≤ 5 →
    ∃ a : Fin 41, largeType a = T := by decide +kernel
theorem distinct_pair : ∀ p, first p ≠ second p := by decide +kernel

theorem enumeration_exact :
    BoundedTraceFamilies.enumerate cost (List.finRange 41) maximum = List.ofFn catalog := by
  decide +kernel

theorem covers (F : Finset (Fin 41))
    (budget : ∀ p, ∑ a ∈ F, cost a p ≤ maximum p) :
    ∃ s : Fin 611, F = catalog s := by
  have h := BoundedTraceFamilies.mem_enumerate cost (List.finRange 41) maximum F
    (fun a _ => by simp) budget
  rw [enumeration_exact] at h
  obtain ⟨s,hs⟩ := List.mem_ofFn.mp h
  exact ⟨s,hs.symm⟩

