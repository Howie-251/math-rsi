def calculated (k : Fin 234) : Numeric.Profile :=
  pruneZero ⟨23,executableType (positions k) Finset.univ,
    labels.map (fun T => ⟨executableType (positions k) T,counts k T⟩),none,[]⟩

private theorem profile_ext (a b : Numeric.Profile)
    (hv : a.v = b.v) (hp : a.positions = b.positions) (ht : a.types = b.types)
    (hc : a.emptyPairCap = b.emptyPairCap) (hk : a.correctionCenters = b.correctionCenters) :
    a = b := by
  cases a
  cases b
  simp_all

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem p_calculated (k : Fin 234) : p k = calculated k := by
  fin_cases k <;> apply profile_ext <;> decide +kernel

theorem p_eq (k : Fin 234) : p k = profile (positions k) (counts k) [] := by
  rw [p_calculated]
  simp only [calculated,executableType_eq,profile,rawProfile]

