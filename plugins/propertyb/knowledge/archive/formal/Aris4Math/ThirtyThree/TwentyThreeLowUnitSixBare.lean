  intro k
  fin_cases k <;> decide +kernel

theorem propertyB_of_counts (H : Simple5Hypergraph (Fin 23))
    (vertices : Fin 6 ↪ Fin 23) (k : Fin 234)
    (actual : ∀ T, MultiLockRecovery.count H vertices T = counts k T) : PropertyB H := by
  obtain ⟨valid,strict,noCap,noCorrection⟩ := certificates k
  have real := TwentyThreeHighSixProfiles.realizes_profile H vertices (positions k) (counts k) actual []
    (by simpa only [← p_eq] using valid)
  rw [← p_eq] at real
  exact ProfileApplication.propertyB_of_uncorrected_profile H vertices (positions k)
    (p k) real noCap noCorrection strict

end Aris4Math.ThirtyThree.TwentyThreeLowUnitSixBare
#print axioms Aris4Math.ThirtyThree.TwentyThreeLowUnitSixBare.propertyB_of_counts
