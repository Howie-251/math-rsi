def pairBudget (e : Fin 6 → Fin 3) : Prop :=
  (e 0).val+(e 1).val+(e 2).val ≤ 2 ∧
  (e 0).val+(e 3).val+(e 4).val ≤ 2 ∧
  (e 1).val+(e 3).val+(e 5).val ≤ 2 ∧
  (e 2).val+(e 4).val+(e 5).val ≤ 2

