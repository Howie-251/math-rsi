theorem pair_covers_vector : ∀ a b c d e f : Fin 3,
    pairBudget ![a,b,c,d,e,f] → ∃ r : Fin 56,
      ∀ i, (![a,b,c,d,e,f] i).val+1 = co r i := by
  unfold pairBudget
  decide +kernel

theorem pair_covers (e : Fin 6 → Fin 3) (budget : pairBudget e) :
    ∃ r : Fin 56, ∀ i, (e i).val+1 = co r i := by
  have same : ![e 0,e 1,e 2,e 3,e 4,e 5] = e := by
    funext i
    fin_cases i <;> rfl
  have h := pair_covers_vector (e 0) (e 1) (e 2) (e 3) (e 4) (e 5)
  rw [same] at h
  exact h budget

def high (a b c d : Fin 3) (q : Fin 2) : Fin 5 → ℕ :=
  ![a.val,b.val,c.val,d.val,q.val]

def highBudget (r : Fin 56) (a b c d : Fin 3) (q : Fin 2) : Prop :=
  a.val+b.val+q.val ≤ co r 0 ∧ a.val+c.val+q.val ≤ co r 1 ∧
  b.val+c.val+q.val ≤ co r 2 ∧ a.val+d.val+q.val ≤ co r 3 ∧
  b.val+d.val+q.val ≤ co r 4 ∧ c.val+d.val+q.val ≤ co r 5

