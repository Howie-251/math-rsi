def calculated (k : Fin 75) : Numeric.Profile :=
  pruneZero ⟨23,executableType (positions k) Finset.univ,
    labels.map (fun T => ⟨executableType (positions k) T,counts k T⟩),none,[]⟩

private theorem profile_ext (a b : Numeric.Profile)
    (hv : a.v = b.v) (hp : a.positions = b.positions) (ht : a.types = b.types)
    (hc : a.emptyPairCap = b.emptyPairCap) (hk : a.correctionCenters = b.correctionCenters) :
    a = b := by
  cases a
  cases b
  simp_all

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem p_calculated (k : Fin 75) : p k = calculated k := by
  fin_cases k <;> apply profile_ext <;> decide +kernel

theorem p_eq (k : Fin 75) : p k = profile (positions k) (counts k) [] := by
  rw [p_calculated]
  simp only [calculated,executableType_eq,profile,rawProfile]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem certificates : ∀ k : Fin 75, Numeric.validProfile (p k) 33 ∧
    Numeric.totalBound (p k) < 1 ∧ (p k).emptyPairCap = none ∧
    (p k).correctionCenters = [] := by
  unfold Numeric.validProfile
  intro k
  fin_cases k <;> decide +kernel

theorem propertyB_of_counts (H : Simple5Hypergraph (Fin 23))
    (vertices : Fin 5 ↪ Fin 23) (k : Fin 75)
    (actual : ∀ T, MultiLockRecovery.count H vertices T = counts k T) : PropertyB H := by
  obtain ⟨valid,strict,noCap,noCorrection⟩ := certificates k
  have real := FiveProfiles.realizes_profile H vertices (positions k) (counts k) actual []
    (by simpa only [← p_eq] using valid)
  rw [← p_eq] at real
  exact ProfileApplication.propertyB_of_uncorrected_profile H vertices (positions k)
    (p k) real noCap noCorrection strict

end Aris4Math.ThirtyThree.TwentyThreeLowUnitFiveBare
#print axioms Aris4Math.ThirtyThree.TwentyThreeLowUnitFiveBare.propertyB_of_counts
