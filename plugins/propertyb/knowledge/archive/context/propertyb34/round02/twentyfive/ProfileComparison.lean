theorem value_grouped_no_table : (∑ k : Fin 25, min (cachedA computed (k.val+1) true)
    (min (cachedA computed (k.val+1) false) (cachedC computed (k.val+1)))) = (12869/12870 : ℚ) := by
  decide +kernel
set_option profiler true in
theorem value_original_numeric : (∑ k : Fin 25, min (Numeric.boundA computed (k.val+1))
    (min (Numeric.boundB computed (k.val+1)) (Numeric.boundC computed (k.val+1)))) = (12869/12870 : ℚ) := by
