def acceptedCheck : Bool :=
  match names nameText, schemas ruleText with
  | some d, some rs => checked d rs ES7Through14Literal.source
  | _, _ => false

theorem accepted : acceptedCheck=true := by native_decide

/-- Every ambient flag and every exact core flag is interpreted in one actual
configuration. Ambient path witnesses are not confined to the selection. -/
theorem impossible (c : Configuration n) (f : Nat→Nat) (m : Model c f) : False := by
  have pass := accepted
  unfold acceptedCheck at pass
  cases hd : names nameText with
  | none => simp [hd] at pass
  | some d =>
    cases hr : schemas ruleText with
    | none => simp [hd,hr] at pass
    | some rs =>
      have ok : checked d rs ES7Through14Literal.source=true := by simpa [hd,hr] using pass
      have sat := checked_sound d rs ES7Through14Literal.source ok c f m
      have unsat := ES7Through14Literal.unsat (assignment d c f)
      rw [sat] at unsat
      contradiction

#print axioms impossible
end ES7Through14Data
