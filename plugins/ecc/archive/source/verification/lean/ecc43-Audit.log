@[reducible] def ECC.Word : ℕ → Type :=
fun n => Fin n → ECC.F2
def ECC.weight : {n : ℕ} → ECC.Word n → ℕ :=
fun {n} x => {i | x i ≠ 0}.card
def ECC.MinWeight : {n : ℕ} → Submodule ECC.F2 (ECC.Word n) → ℕ → Prop :=
fun {n} C d => ∀ x ∈ C, x ≠ 0 → d ≤ ECC.weight x
def ECC.CodeExists : ℕ → ℕ → ℕ → Prop :=
fun n k d => ∃ C, Module.finrank ECC.F2 ↥C = k ∧ ECC.MinWeight C d
def ECC.MainClaim : Prop :=
¬ECC.CodeExists 43 10 17
def ECC.ExactMinWeight : {n : ℕ} → Submodule ECC.F2 (ECC.Word n) → ℕ → Prop :=
fun {n} C d => ECC.MinWeight C d ∧ ∃ x ∈ C, x ≠ 0 ∧ ECC.weight x = d
def ECC.FullSupport : {n : ℕ} → Submodule ECC.F2 (ECC.Word n) → Prop :=
fun {n} C => ∀ (i : Fin n), ∃ x ∈ C, x i ≠ 0
def ECC.CatalogueReduction : Prop :=
∀ (T : Submodule ECC.F2 (ECC.Word 44)),
  Module.finrank ECC.F2 ↥T = 10 →
    ECC.MinWeight T 18 →
      ECC.EvenCode T →
        ∃ rows ∈ ECC.Packed.catalogueRows,
          ∃ a b c,
            ECC.EvenCode (ECC.StandardExtension (ECC.matrixCode 40 rows) a b c) ∧
              ECC.MinWeight (ECC.StandardExtension (ECC.matrixCode 40 rows) a b c) 18
def ECC.CatalogueExclusions : Prop :=
∀ rows ∈ ECC.Packed.catalogueRows, ECC.PairIncompatible (ECC.matrixCode 40 rows)
def ECC.PublishedNonexistence41 : Prop :=
∀ (C : Submodule ECC.F2 (ECC.Word 41)), Module.finrank ECC.F2 ↥C = 8 → ¬ECC.ExactMinWeight C 18
def ECC.PublishedClassBound : Prop :=
∀ (f : Fin 173 → Submodule ECC.F2 (ECC.Word 40)),
  (∀ (i : Fin 173), ECC.MotherParameters (f i)) → ∃ i j, i ≠ j ∧ ECC.CoordinateEquivalent (f i) (f j)
def ECC.CatalogueInequivalent : Prop :=
∀ (i j : Fin 172), i ≠ j → ¬ECC.CoordinateEquivalent (ECC.catalogueCode i) (ECC.catalogueCode j)
def ECC.MotherParameters : Submodule ECC.F2 (ECC.Word 40) → Prop :=
fun K => Module.finrank ECC.F2 ↥K = 7 ∧ ECC.ExactMinWeight K 18 ∧ ECC.EvenCode K ∧ ECC.FullSupport K
def ECC.CoordinateEquivalent : {n : ℕ} → Submodule ECC.F2 (ECC.Word n) → Submodule ECC.F2 (ECC.Word n) → Prop :=
fun {n} C D => ∃ e, ECC.permuteCode e C = D
def ECC.PairIncompatible : Submodule ECC.F2 (ECC.Word 40) → Prop :=
fun K =>
  ∀ (a b : ECC.Word 40),
    Even (ECC.weight a) → Even (ECC.weight b) → ECC.Far K 16 a → ECC.Far K 16 b → ¬ECC.Far K 16 (a + b)
